---
// Layout for full, confidential case studies shared by private link only.
// Pages using it are hidden from search engines and from the sitemap, and nothing on the site links to them.
import BaseLayout from './BaseLayout.astro';
import '../styles/case-study.css';

const { frontmatter } = Astro.props;
const d = frontmatter;
const facts = [
  { label: 'Company', value: d.company },
  { label: 'My Role', value: d.role },
  { label: 'Timeline', value: d.timeline },
  { label: 'Platforms', value: (d.platforms ?? []).join(', ') },
  { label: 'Team', value: d.team },
].filter((m) => m.value);
---

<BaseLayout title={`${d.title} (full case study)`} description={d.summary} noindex>
  <article class="cs" style={d.tint ? `--tint: ${d.tint}` : undefined}>
    <header class="cs-hero">
      <div class="cs-hero-inner">
        <a href="/#work" class="cs-back">← All Work</a>
        <p class="cs-pill">{d.category}</p>
        <h1 class="cs-title">{d.title}</h1>
        <p class="cs-summary">{d.summary}</p>
      </div>
      {d.heroImage && (
        <div class="cs-hero-image">
          <img src={d.heroImage} alt={d.heroImageAlt ?? ''} width="1600" height="700" />
        </div>
      )}
    </header>

    <dl class="cs-facts">
      {facts.map((m) => (
        <div>
          <dt>{m.label}</dt>
          <dd>{m.value}</dd>
        </div>
      ))}
    </dl>

    <div class="cs-body">
      <aside class="cs-confidential" role="note">
        <strong>Confidential.</strong> This full case study is shared privately. Please don’t forward or publish this link.
      </aside>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
