---
// Simple outline icons for the "What I Can Contribute To" section.
interface Props { name: 'research' | 'strategy' | 'interface' | 'systems' }
const { name } = Astro.props;
---

<svg class="service-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor"
  stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'research' && (
    <>
      <circle cx="10.5" cy="10.5" r="6.5" />
      <path d="m15.5 15.5 5 5" />
      <circle cx="10.5" cy="9" r="1.8" />
      <path d="M7.4 13.6a3.6 3.6 0 0 1 6.2 0" />
    </>
  )}
  {name === 'strategy' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="m15.5 8.5-2 5-5 2 2-5z" />
    </>
  )}
  {name === 'interface' && (
    <>
      <rect x="3" y="4" width="18" height="13" rx="2" />
      <path d="M3 8h18" />
      <path d="m12.5 12 5.5 2-2.3.9-.9 2.3z" />
    </>
  )}
  {name === 'systems' && (
    <>
      <rect x="3.5" y="3.5" width="7" height="7" rx="1.5" />
      <rect x="13.5" y="3.5" width="7" height="7" rx="1.5" />
      <rect x="3.5" y="13.5" width="7" height="7" rx="1.5" />
      <circle cx="17" cy="17" r="3.5" />
    </>
  )}
</svg>
